<% layout('/layouts/boilerplate.ejs') -%>


<div class="container mt-4">
    <h2 class="text-center">Trip Details</h2>
    <button class="btn btn-primary mt-3" style="background-color: rgb(3, 3, 66); color: white;" data-bs-toggle="modal" data-bs-target="#addExpenseModal">
        Add Expense
    </button>
    <br><hr><br>

    <table class="table table-striped table-bordered text-center mt-3">
        <thead class="table-dark">
            <tr>
                <th>Category</th>
                <th>Spent (<%= trip.inputCurrency %>)</th>
                <th>Spent at Home (<%= trip.outputCurrency %>)</th>
            </tr>
        </thead>
        <tbody>
            <% for (let category in groupedExpenses) { %>
                <tr>
                    <td><%= category %></td>
                    <td><%= groupedExpenses[category].amount %> <%= trip.inputCurrency %></td>
                    <td><%= groupedExpenses[category].convertedAmount.toFixed(2) %> <%= trip.outputCurrency %></td>
                </tr>
            <% } %>
        </tbody>
    </table>

    <br><br><hr><br>
    <h2>Your Total expenses</h2>
    <table class="table table-striped table-bordered text-center mt-3">
        <tbody>
            <tr>
                <td><%= trip.inputCurrency %></td>
                <td><%= totalSpentInputCurrency.toFixed(2) %></td>
            </tr>
            <tr>
                <td><%= trip.outputCurrency %></td>
                <td><%= totalSpentOutputCurrency.toFixed(2) %></td>
            </tr>
        </tbody>
    </table>
    

    <!-- Add Expense Button -->
   
    <!-- Modal -->
    <div class="modal fade" id="addExpenseModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Expense</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form action="/trips/<%= trip._id %>/add-expense" method="POST">
                        <div class="mb-3">
                            <label class="form-label">Category</label>
                            <input type="text" name="category" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Amount (<%= trip.inputCurrency %>)</label>
                            <input type="number" name="amount" class="form-control" required min="1">
                        </div>
                        <input type="hidden" name="currency" value="<%= trip.inputCurrency %>">
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary" style="background-color: rgb(3, 3, 66); color: white;">Add Expense</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
