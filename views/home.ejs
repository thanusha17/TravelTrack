<% layout('/layouts/boilerplate.ejs') -%>
<style>
    .hero-section {
        background: linear-gradient(to right, rgba(4, 4, 48, 0.7), rgba(76, 76, 151, 0.7));
        width: 100vw;
        height: 90vh;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
        margin:0;
    }
    @media (max-width: 768px) { /* Tablets & Mobile */
    .hero-section {
        height: 70vh;
    }
    }

    @media (max-width: 480px) { /* Small Phones */
    .hero-section {
        height: 60vh; 
    }
    }
    .container{
        padding: 0 !important;
        margin: 0 !important;
    }

    .hero-bg {
        background: url('https://images.unsplash.com/photo-1530250418330-cb2c35da5277?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D') no-repeat center center/cover;
        filter: blur(3px);
        opacity: 0.4;
    }
</style>

<section class="hero-section position-relative text-white text-center m-0">
    <!-- Background Image -->
    <div class="hero-bg position-absolute top-0 start-0 w-100 h-100"></div>

    <!-- Content -->
    <div class="container position-relative z-1 d-flex flex-column align-items-center justify-content-center vh-100">
        <h1 class="display-4 fw-bold">Track Your Travel Expenses Effortlessly!</h1>
        <p class="lead mt-3">Convert currencies, set budgets, and explore stress-free. Start tracking your journey today!</p>
        <a href="/trips" class="btn btn-light btn-lg mt-4 fw-semibold">Start Tracking Now</a>
    </div>
</section>


<section class="container text-center my-5">
    <div class="mb-5">
    <h2 class="fw-bold mb-4 how-it-works-title sec2">What's in it for you</h2>

    <div class="row justify-content-center gy-3">
        <div class="col-12 col-md-6 col-lg-4 d-flex justify-content-center">
            <div class="card shadow how-it-works-card p-4 text-center" data-aos="fade-up">
                <i class="fas fa-plane-departure fa-2x mb-2"></i>
                <h5>Log Your Journey</h5>
                <p>Add trips, select currency, and set budgets easily.</p>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4 d-flex justify-content-center">
            <div class="card shadow how-it-works-card p-4 text-center" data-aos="fade-up" data-aos-delay="200">
                <i class="fas fa-wallet fa-2x mb-2"></i>
                <h5>Track Expenses</h5>
                <p>Categorize spending and convert currencies instantly.</p>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4 d-flex justify-content-center">
            <div class="card shadow how-it-works-card p-4 text-center" data-aos="fade-up" data-aos-delay="400">
                <i class="fas fa-chart-line fa-2x mb-2"></i>
                <h5>Stay on Budget</h5>
                <p>Get insights & manage your travel expenses smartly.</p>
            </div>
        </div>
    </div>
</div>
</section>

<section class="join-community text-center py-5">
    <div class="container">
        <h2 class="fw-bold mb-3">Start Managing Your Travel Expenses Today!</h2>
        <p class="lead text-muted">Join thousands of travelers who manage trips seamlessly.</p>
        <a href="/trips" class="btn btn-primary btn-lg mt-3">Get Started Now</a>
    </div>
</section>

