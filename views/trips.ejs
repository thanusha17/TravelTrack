<% layout('/layouts/boilerplate.ejs') -%>

<div class="container mt-5">
    <h2 class="text-center mb-5">Your Travel Journeys</h2>
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a href="/trips/new" class="btn btn-primary" style="background-color: rgb(22, 22, 46); color: white;">+ Add New Trip</a>
    </div>

    <div class="row">
        <% if (trips.length > 0) { %>
            <% trips.forEach(trip => { %>
                <div class="col-md-4 mb-4">
                    <div class="card shadow">
                        <div class="card-body">
                            <h5 class="card-title"><%= trip.destination %></h5>
                            <p class="card-text">Currency: <%= trip.inputCurrency %> → <%= trip.outputCurrency %></p>
                            <p class="card-text">Budget: <%= trip.totalBudget %> <%= trip.outputCurrency %></p>
                            <a href="/trips/<%= trip._id %>" class="btn btn-info" style="background-color: rgb(51, 51, 82); color: white;">View Details</a>
                        </div>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <p class="text-center">No trips found. Start by adding a new trip!</p>
        <% } %>
    </div>
    
</div>


